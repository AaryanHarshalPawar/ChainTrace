# Copy to backend/.env and fill in. Every key is optional -- the system runs
# keyless -- but a free TronGrid key makes a real difference to trace speed.

# --- Explorer API keys -------------------------------------------------
# Free, 2 minutes to obtain, at https://www.trongrid.io/dashboard
# Without it, TronGrid rate-limits at roughly 1 request/second and a cold
# multi-hop trace takes tens of seconds. With it, several times faster.
TRONGRID_API_KEY=

# Free at https://etherscan.io/apis -- one key covers 60+ EVM chains via the
# Etherscan V2 API (Ethereum, BSC, Polygon, Arbitrum).
ETHERSCAN_API_KEY=

# --- Hybrid data strategy ----------------------------------------------
# true  = serve every request from the local cache, never touch the network.
#         Use for demos. Requires a warmed cache: scripts/seed_snapshot.py
# false = live calls, cached as they go, with stale-cache fallback on failure.
OFFLINE_MODE=false
CACHE_TTL_SECONDS=86400

# --- Tracing budget -----------------------------------------------------
MAX_TRACE_HOPS=5
MAX_NODES_PER_TRACE=400
MAX_TRANSFERS_PER_ADDRESS=200

ENVIRONMENT=development
